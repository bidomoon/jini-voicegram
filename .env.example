# Configure only after owner approval of the provider's usage charges.
OPENAI_API_KEY=
AI_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1.5

# Natural conversation (independent from image/video generation)
CHAT_ENABLED=false
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Use a strong random test access code of at least 24 characters.
VOICEGRAM_ACCESS_CODE=

# Media generation and personal Instagram pilot
MEDIA_ENABLED=false
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Higgsfield app API credential, server-only. Paste the complete copied key.
# Plugin/MCP credits and authentication do not enable the app API.
HF_API_KEY=
# Alternatively configure both HF_API_KEY_ID and HF_API_KEY_SECRET.
# Optional, only to recover videos submitted before the Higgsfield migration.
RUNWAYML_API_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# Server-only, distinct from the tester access code; at least 32 random characters
SOCIAL_SESSION_SECRET=

# Kakao login (enable only after callback/domain and consent configuration)
APP_ORIGIN=https://jini-voicegram.netlify.app
KAKAO_LOGIN_ENABLED=false
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Toss Payments v2 widget TEST keys only. Live charging is not implemented.
PAYMENTS_TEST_ENABLED=false
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
TOSS_VARIANT_KEY=DEFAULT
